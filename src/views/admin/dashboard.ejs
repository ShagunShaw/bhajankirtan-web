
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= title %></title>

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Rozha+One&family=Mukta:wght@400;500;600;700&display=swap" rel="stylesheet">

  <link rel="stylesheet" href="/css/admin-dashboard.css">
  <script src="/js/admin-dashboard.js" defer></script>
</head>
<body>

  <%- include("../partials/admin-header") %>

  <main class="admin-wrap">
    <div class="page-head">
      <div>
        <h1>Namaste, Admin 🙏</h1>
        <p>Here is what needs your attention today.</p>
      </div>
      <span class="today-date" id="todayDate">Loading date...</span>
    </div>

    <div class="stats">
      <div class="stat">
        <div class="ico">📖</div>
        <div>
          <b id="cTotal">—</b>
          <span>Total Bookings</span>
        </div>
      </div>

      <div class="stat warn">
        <div class="ico">⏳</div>
        <div>
          <b id="cPending">—</b>
          <span>Pending Requests</span>
        </div>
      </div>

      <div class="stat">
        <div class="ico">🪔</div>
        <div>
          <b id="cUpcoming">—</b>
          <span>Upcoming Confirmed</span>
        </div>
      </div>
    </div>

    <div class="cols">
      <section class="panel">
        <div class="panel-head">
          <div>
            <h2>Tomorrow's Events</h2>
            <small id="tomorrowDate"></small>
          </div>
          <span class="count" id="tomorrowCount">0</span>
        </div>

        <div class="list" id="tomorrowList">
          <div class="loading">Loading events...</div>
        </div>
      </section>

      <section class="panel">
        <div class="panel-head">
          <div>
            <h2>Today's Events</h2>
            <small id="todayDate2"></small>
          </div>
          <span class="count" id="todayCount">0</span>
        </div>

        <div class="list" id="todayList">
          <div class="loading">Loading events...</div>
        </div>
      </section>
    </div>
  </main>

  <!-- Package confirmation information popup -->
  <div class="modal-overlay" id="packageConfirmModal">
    <div class="modal-box" role="dialog" aria-modal="true"
      aria-labelledby="packageModalTitle">

      <div class="modal-icon">🙏</div>

      <h2 id="packageModalTitle">Package Booking</h2>

      <p>
        Please confirm this booking from the Bookings page itself.
      </p>

      <button type="button" class="btn modal-ok" id="packageConfirmOk">
        OK
      </button>
    </div>
  </div>

  <div id="toast" role="status" aria-live="polite"></div>

  <%- include("../partials/admin-footer") %>

</body>
</html>
