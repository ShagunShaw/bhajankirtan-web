<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= title %></title>

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Rozha+One&family=Mukta:wght@400;500;600;700&display=swap" rel="stylesheet">

  <link rel="stylesheet" href="/css/admin-dashboard.css">
  <link rel="stylesheet" href="/css/admin-performers.css">
</head>
<body>

  <%- include("../partials/admin-header") %>

  <main class="pf-page">
    <div class="admin-wrap">
      <a href="/admin/performers" class="pf-back">← Back to performers</a>

      <div class="pf-head">
        <h1>Add Performer</h1>
        <span class="pf-count"><span class="pn-req">*</span> marked fields are compulsory</span>
      </div>

      <form id="pnForm" class="pn-form" novalidate autocomplete="off">

        <section class="pd-card">
          <h3>Basic details</h3>
          <div class="pn-grid">
            <div class="pf-field pn-full">
              <label for="fullName">Full name <span class="pn-req">*</span></label>
              <input id="fullName" type="text" maxlength="120" placeholder="e.g. Pt. Ramesh Sharma">
              <small class="pn-err" id="err-fullName"></small>
            </div>

            <div class="pf-field">
              <label for="basePrice">Base price (₹) <span class="pn-req">*</span></label>
              <input id="basePrice" type="number" min="1" step="1" inputmode="numeric" placeholder="e.g. 8000">
              <small class="pn-err" id="err-basePrice"></small>
            </div>

            <div class="pf-field">
              <label for="experience">Experience</label>
              <input id="experience" type="text" maxlength="40" placeholder="e.g. 12 yrs">
            </div>

            <div class="pf-field">
              <label for="visibility">Visibility</label>
              <select id="visibility">
                <option value="visible" selected>Visible</option>
                <option value="hidden">Hidden</option>
              </select>
            </div>

            <div class="pf-field pn-full">
              <label for="about">About</label>
              <textarea id="about" rows="5" maxlength="2000" placeholder="Short description of the artist"></textarea>
            </div>
          </div>
        </section>

        <section class="pd-card">
          <h3>Tags <span class="pn-req">*</span></h3>
          <div class="pn-tagbox" id="tagBox">
            <span id="tagChips"></span>
            <input id="tagInput" type="text" placeholder="Type a tag and press Enter" aria-label="Add tag">
          </div>
          <small class="pn-hint">Press Enter or comma to add. At least one tag is required.</small>
          <small class="pn-err" id="err-tags"></small>
        </section>

        <section class="pd-card">
          <h3>Profile photo</h3>
          <div class="pn-profile">
            <div class="pn-profile-prev" id="profilePrev">No photo</div>
            <div>
              <input id="profileInput" type="file" accept="image/*" hidden>
              <button type="button" class="pf-btn pf-btn-line" id="profilePick">Choose photo</button>
              <button type="button" class="pf-btn pf-btn-line" id="profileClear" hidden>Remove</button>
              <p class="pn-hint" id="profileName">Optional, but recommended.</p>
            </div>
          </div>
        </section>

        <section class="pd-card">
          <h3>Work photos <span class="pn-count" id="photoCount">0 / 10</span></h3>
          <input id="photoInput" type="file" accept="image/*" multiple hidden>
          <button type="button" class="pf-btn pf-btn-line" id="photoPick">+ Add photos</button>
          <div class="pn-thumbs" id="photoGrid"></div>
        </section>

        <section class="pd-card">
          <h3>Work videos <span class="pn-count" id="videoCount">0 / 5</span></h3>
          <input id="videoInput" type="file" accept="video/*" multiple hidden>
          <button type="button" class="pf-btn pf-btn-line" id="videoPick">+ Add videos</button>
          <ul class="pn-files" id="videoList"></ul>
        </section>

        <div class="pn-progress" id="pnProgress" hidden>
          <div class="pn-bar"><i id="pnBar"></i></div>
          <span id="pnProgressText">Uploading… 0%</span>
        </div>

        <div class="pn-actions">
          <a href="/admin/performers" class="pf-btn pf-btn-line pn-cancel">Cancel</a>
          <button type="submit" class="pf-btn pf-btn-red" id="pnSubmit">Submit</button>
        </div>
      </form>
    </div>

    <div class="pf-toast" id="pfToast" role="status" aria-live="polite"></div>
  </main>

  <%- include("../partials/admin-footer") %>

  <script src="/js/admin-performer-new.js"></script>
</body>
</html>