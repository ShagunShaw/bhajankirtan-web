<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= title %></title>

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Rozha+One&family=Mukta:wght@400;500;600;700&display=swap" rel="stylesheet">

  <link rel="stylesheet" href="/css/admin-dashboard.css">
  <link rel="stylesheet" href="/css/admin-performers.css">
  <link rel="stylesheet" href="/css/admin-pricing.css">
</head>
<body>

  <%- include("../partials/admin-header") %>

  <main class="pf-page">
    <div class="admin-wrap">

      <div class="pf-head">
        <h1>Pricing</h1>
      </div>

      <div class="pf-state" id="prLoading">Loading pricing...</div>
      <div class="pf-state pf-error" id="prError" hidden></div>

      <div class="pr-grid" id="prGrid" hidden>

        <section class="pr-panel">
          <header class="pr-panel-head">
            <div>
              <h2>Base Prices</h2>
              <span class="pf-count" id="baseCount"></span>
            </div>
          </header>
          <div class="pr-scroll" id="baseList"></div>
        </section>

        <section class="pr-panel">
          <header class="pr-panel-head">
            <div>
              <h2>Peak Prices</h2>
              <span class="pf-count" id="peakCount"></span>
            </div>
            <button type="button" class="pf-btn pf-btn-red" id="addPeakBtn">+ Add Peak Price</button>
          </header>
          <div class="pr-scroll" id="peakList"></div>
        </section>

      </div>
    </div>

    <div class="pf-toast" id="pfToast" role="status" aria-live="polite"></div>
  </main>

  <%- include("../partials/admin-footer") %>

  <script src="/js/admin-pricing.js"></script>
</body>
</html>