<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= title %></title>

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Rozha+One&family=Mukta:wght@400;500;600;700&display=swap" rel="stylesheet">

  <link rel="stylesheet" href="/css/admin-dashboard.css">
  <link rel="stylesheet" href="/css/admin-performers.css">
</head>
<body>

  <%- include("../partials/admin-header") %>

  <main class="pf-page" id="pdRoot" data-performer-id="<%= performerId %>">
    <div class="admin-wrap">
      <a href="/admin/performers" class="pf-back">← Back to performers</a>

      <div class="pf-state" id="pdLoading">Loading performer...</div>
      <div class="pf-state pf-error" id="pdError" hidden></div>

      <div id="pdContent" hidden></div>
    </div>

    <button type="button" class="pf-fab" id="editPerformerBtn">✎ Edit Performer</button>
    <div class="pf-toast" id="pfToast" role="status" aria-live="polite"></div>
  </main>

  <%- include("../partials/admin-footer") %>

  <script src="/js/admin-performer-detail.js"></script>
</body>
</html>