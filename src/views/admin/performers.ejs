<%- include('../partials/admin-header', { title, active }) %>
<h1>Performers</h1>

<table>
  <tr><th>Name</th><th>Events</th><th>City</th><th>Base price</th><th>Visible</th><th>Actions</th></tr>
  <% performers.forEach(p => { %>
    <tr>
      <td><%= p.name %></td>
      <td><%= p.speciality %></td>
      <td><%= p.city %></td>
      <td>₹<%= p.price.toLocaleString('en-IN') %></td>
      <td><span class="pill <%= p.active ? 'yes' : 'no' %>"><%= p.active ? 'Visible' : 'Hidden' %></span></td>
      <td>
        <button class="btn-xs">Edit</button>
        <button class="btn-xs grey"><%= p.active ? 'Hide' : 'Show' %></button>
        <button class="btn-xs red">Delete</button>
      </td>
    </tr>
  <% }) %>
</table>

<a href="/admin/performers/new" class="fab">+ Add Performer</a>
<%- include('../partials/admin-footer') %>