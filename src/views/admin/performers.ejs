<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= title %></title>

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Rozha+One&family=Mukta:wght@400;500;600;700&display=swap" rel="stylesheet">

  <link rel="stylesheet" href="/css/admin-dashboard.css">
  <link rel="stylesheet" href="/css/admin-performers.css">
</head>
<body>

  <%- include("../partials/admin-header") %>

  <main class="pf-page">
    <div class="admin-wrap">

      <div class="pf-head">
        <h1>Performers</h1>
        <span class="pf-count" id="pfCount"></span>
      </div>

      <form class="pf-filter" id="pfFilter" autocomplete="off">
        <div class="pf-field">
          <label for="fName">Performer name</label>
          <input id="fName" type="text" list="nameList" placeholder="Type or pick a name">
          <datalist id="nameList"></datalist>
        </div>
        <div class="pf-field">
          <label for="fTag">Tag</label>
          <input id="fTag" type="text" list="tagList" placeholder="Type or pick a tag">
          <datalist id="tagList"></datalist>
        </div>
        <div class="pf-filter-actions">
          <button type="submit" class="pf-btn pf-btn-red">Search</button>
          <button type="button" class="pf-btn pf-btn-line" id="fReset">Reset</button>
        </div>
      </form>

      <div class="pf-state" id="pfLoading">Loading performers...</div>
      <div class="pf-state pf-error" id="pfError" hidden></div>
      <div class="pf-state" id="pfEmpty" hidden>No performers match your search.</div>

      <div class="pf-list" id="pfList"></div>
    </div>

    <a href="/admin/performers/new" class="pf-fab">+ Add Performer</a>
    <div class="pf-toast" id="pfToast" role="status" aria-live="polite"></div>
  </main>

  <%- include("../partials/admin-footer") %>

  <script src="/js/admin-performers.js"></script>
</body>
</html>