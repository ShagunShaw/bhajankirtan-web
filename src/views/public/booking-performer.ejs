
<%- include("../partials/header") %>

<main class="wrap booking-page">
  <a href="/performers/<%= encodeURIComponent(performerId) %>" class="back-link">
    ← Back to performer
  </a>

  <section class="booking-card">
    <div class="booking-heading">
      <p class="eyebrow">BHAJANKIRTAN</p>
      <h1>Book a Performer</h1>
      <p>Share your event details to submit a booking request.</p>
    </div>

    <form
      id="performerBookingForm"
      data-performer-id="<%= performerId %>"
    >
      <div class="booking-form-grid">

        <div class="form-field">
          <label for="customerName">Full Name <span>*</span></label>
          <input
            type="text"
            id="customerName"
            name="customerName"
            placeholder="Enter your full name"
            autocomplete="name"
            required
          >
        </div>

        <div class="form-field">
          <label for="phone">Phone Number <span>*</span></label>
          <input
            type="tel"
            id="phone"
            name="phone"
            placeholder="Enter your phone number"
            autocomplete="tel"
            required
          >
        </div>

        <div class="form-field">
          <label for="email">Email Address</label>
          <input
            type="email"
            id="email"
            name="email"
            placeholder="Enter your email"
            autocomplete="email"
          >
        </div>

        <div class="form-field">
          <label for="eventType">Event Type <span>*</span></label>
          <select id="eventType" name="eventType" required>
            <option value="">Select event type</option>
            <option value="jagrata">Jagrata</option>
            <option value="mata ki chowki">Mata Ki Chowki</option>
            <option value="satsang">Satsang</option>
            <option value="sundarkand">Sundarkand</option>
            <option value="rudra abhishek">Rudra Abhishek</option>
            <option value="other">Other</option>
          </select>
        </div>

        <div class="form-field">
          <label for="eventDate">Event Date <span>*</span></label>
          <input
            type="date"
            id="eventDate"
            name="eventDate"
            required
          >
        </div>

        <div class="form-field">
          <label for="eventTime">Event Time <span>*</span></label>
          <input
            type="time"
            id="eventTime"
            name="eventTime"
            required
          >
        </div>

        <div class="form-field full-width">
          <label for="eventAddress">Event Address <span>*</span></label>
          <textarea
            id="eventAddress"
            name="eventAddress"
            rows="3"
            placeholder="Enter the complete event address"
            required
          ></textarea>
        </div>

        <div class="form-field">
          <label for="expectedGuests">Expected Guests</label>
          <input
            type="number"
            id="expectedGuests"
            name="expectedGuests"
            min="1"
            step="1"
            placeholder="Approximate guest count"
          >
        </div>

        <div class="form-field full-width">
          <label for="additionalNote">Additional Notes</label>
          <textarea
            id="additionalNote"
            name="additionalNote"
            rows="4"
            placeholder="Any special requirements? (optional)"
          ></textarea>
        </div>

      </div>

      <p class="required-note">Fields marked * are compulsory.</p>

      <button type="submit" id="submitBooking" class="btn btn-primary booking-submit">
        Submit Booking Request
      </button>

      <p id="bookingError" class="booking-error" role="alert" hidden></p>
    </form>
  </section>
</main>

<!-- Loading spinner -->
<div id="bookingLoader" class="booking-loader" hidden>
  <div class="booking-loader-content">
    <div class="booking-spinner"></div>
    <p>Submitting your booking request...</p>
    <small>Please wait a moment.</small>
  </div>
</div>

<style>
  .booking-loader[hidden],
  .booking-modal[hidden] {
    display: none !important;
  }

  .booking-loader {
    position: fixed;
    inset: 0;
    z-index: 10001;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(0, 0, 0, 0.65);
    backdrop-filter: blur(3px);
    color: white;
    text-align: center;
  }

  .booking-spinner {
    width: 55px;
    height: 55px;
    margin: 0 auto 18px;
    border: 5px solid rgba(255, 255, 255, 0.3);
    border-top-color: var(--crimson, #b42335);
    border-radius: 50%;
    animation: bookingSpin 0.8s linear infinite;
  }

  .booking-loader-content p {
    margin-bottom: 6px;
    font-weight: 600;
  }

  @keyframes bookingSpin {
    to {
      transform: rotate(360deg);
    }
  }
</style>

<!-- Booking response popup -->
<div
  id="bookingModal"
  class="booking-modal"
  role="dialog"
  aria-modal="true"
  aria-labelledby="bookingModalTitle"
  hidden
>
  <div class="booking-modal-backdrop"></div>

  <section class="booking-modal-content">
    <button
      type="button"
      id="closeBookingModal"
      class="booking-modal-close"
      aria-label="Close popup"
    >&times;</button>

    <p class="eyebrow">BOOKING RESPONSE</p>
    <h2 id="bookingModalTitle">Booking Request Response</h2>

    <div id="referenceSection" class="reference-section" hidden>
      <p>Your Booking Reference ID</p>

      <div class="reference-id-row">
        <strong id="referenceId"></strong>
        <button type="button" id="copyReferenceId" class="copy-reference-btn">
          Copy ID
        </button>
      </div>

      <p id="copyMessage" class="copy-message" aria-live="polite"></p>
      <p class="reference-help">
        Save this ID to check your booking status later.
      </p>
    </div>

    <div id="bookingResponseContent"></div>

    <button
  type="button"
  id="doneBookingModal"
  class="btn btn-primary modal-done-btn"
>
  Back to Home
</button>
  </section>
</div>

<script src="/js/booking-performer.js" defer></script>

<%- include("../partials/footer") %>