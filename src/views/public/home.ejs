<%- include("../partials/header", { title: "BhajanKirtan | Book Devotional Artists" }) %>
<%
  const PERF_LIMIT = 8, PACK_LIMIT = 6;
  const grads = [
    "linear-gradient(160deg,#f59e0b,#b45309)", "linear-gradient(160deg,#9b1c32,#52091a)",
    "linear-gradient(160deg,#e07b00,#7a1022)", "linear-gradient(160deg,#c2410c,#7c2d12)"
  ];
  const inr = (n) => "₹" + Number(n || 0).toLocaleString("en-IN");
  const initial = (name = "") => name.replace(/^(Pt\.|Acharya|Shri|Shree)\s+/i, "").trim().charAt(0).toUpperCase();
  const isUrl = (v) => /^https?:\/\//i.test(v || "");
  const cld = (url, t) => /res\.cloudinary\.com/.test(url) && url.includes("/upload/") ? url.replace("/upload/", `/upload/${t}/`) : url;
  const tagName = (t) => String(typeof t === "string" ? t : (t.displayName || t.name || "")).replace(/_/g, " ");

  // today's date in IST as YYYY-MM-DD
  const today = new Date().toLocaleDateString("en-CA", { timeZone: "Asia/Kolkata" });
  const priceFor = (p) => {
    const peak = (p.peakPeriods || []).find((x) => today >= String(x.from).slice(0, 10) && today <= String(x.to).slice(0, 10));
    return peak ? { amount: peak.price, label: peak.label } : { amount: p.basePrice, label: "" };
  };

  const perfAll = performers || [];
  const packAll = packages || [];
  const perfShown = perfAll.slice(0, PERF_LIMIT);
  const packShown = packAll.slice(0, PACK_LIMIT);
%>

<!-- HERO -->
<div class="hero">
  <div class="wrap hero-grid">
    <div>
      <span class="kicker">॥ Shubh Aarambh ॥</span>
      <h1>Invite Divine Music <span>Into Your Home</span></h1>
      <p class="sub">Book verified bhajan singers, kirtan mandalis and pandits for Jagrata, Mata ki Chowki, Rudra Abhishek and every sacred occasion.</p>
      <form class="search" action="/performers" method="GET">
        <input type="text" name="q" placeholder="Search artist or event type">
        <button type="submit">Search</button>
      </form>
      <div class="pop">
        Popular:
        <a href="/performers?tag=jagrata">Jagrata</a>
        <a href="/performers?tag=mata-ki-chowki">Mata ki Chowki</a>
        <a href="/performers?tag=satsang">Satsang</a>
      </div>
    </div>
    <div class="window"><span>ॐ</span></div>
  </div>
</div>
<div class="garland"></div>

<!-- EVENT TYPES -->
<div class="events">
  <div class="wrap ev-row">
    <a href="/performers?tag=jagrata" class="ev"><div class="ring">🪔</div><b>Jagrata</b></a>
    <a href="/performers?tag=mata-ki-chowki" class="ev"><div class="ring">🔱</div><b>Mata ki Chowki</b></a>
    <a href="/performers?tag=rudra-abhishek" class="ev"><div class="ring">🕉️</div><b>Rudra Abhishek</b></a>
    <a href="/performers?tag=satsang" class="ev"><div class="ring">📿</div><b>Satsang</b></a>
    <a href="/performers?tag=sundarkand" class="ev"><div class="ring">🚩</div><b>Sundarkand</b></a>
  </div>
</div>

<!-- PERFORMERS -->
<section id="performers">
  <div class="wrap">
    <div class="head">
      <h2>Our Featured Artists</h2>
      <div class="orn">❖</div>
      <p>Handpicked performers trusted by hundreds of families</p>
    </div>
        <div class="g-perf">
      <% if (!perfShown.length) { %>
        <p class="empty">Artists will appear here soon.</p>
      <% } %>
      <% perfShown.forEach((p, i) => { const pr = priceFor(p); %>
        <a href="/performers/<%= p.id || p._id %>" class="perf">
          <div class="arch" style="background:<%= grads[i % grads.length] %>">
            <% if (isUrl(p.profilePhoto)) { %>
              <img src="<%= cld(p.profilePhoto, 'w_400,h_460,c_fill,g_face,q_auto,f_auto') %>" alt="<%= p.fullName %>" loading="lazy">
            <% } else { %>
              <%= initial(p.fullName) %>
            <% } %>
          </div>
          <h3><%= p.fullName %></h3>
          <% if (p.experience) { %><div class="exp"><%= p.experience %> experience</div><% } %>
          <div class="tags">
            <% (p.tags || []).slice(0, 3).forEach((t) => { %>
              <span class="tag"><%= tagName(t) %></span>
            <% }) %>
          </div>
          <div class="price">
            From <b><%= inr(pr.amount) %></b>
            <% if (pr.label) { %><span class="peak-label"><%= pr.label %></span><% } %>
          </div>
          <span class="go">View &amp; Book</span>
        </a>
      <% }) %>
    </div>
    <% if (perfAll.length > PERF_LIMIT) { %>
      <div class="center"><a href="/performers" class="btn btn-red">Load More Performers</a></div>
    <% } %>
  </div>
</section>

<!-- PACKAGES -->
<div class="garland"></div>
<section id="packages" class="packs">
  <div class="wrap">
    <div class="head">
      <h2>Popular Packages</h2>
      <div class="orn" style="color:var(--gold-soft)">❖</div>
      <p>Artists, sound and setup in one simple booking</p>
    </div>
        <div class="g-pack">
      <% if (!packShown.length) { %>
        <p class="empty">Packages will appear here soon.</p>
      <% } %>
      <% packShown.forEach((pkg, i) => { const shots = (pkg.workPhotos || []).filter(isUrl).slice(0, 4); %>
        <div class="pack <%= i === 1 ? 'best' : '' %>">
          <% if (i === 1) { %><span class="stamp">MOST BOOKED</span><% } %>

          <% if (shots.length) { %>
            <div class="fan" aria-hidden="true">
              <% shots.forEach((src, k) => { const mid = (shots.length - 1) / 2; %>
                <div class="fan-card" style="--a:<%= (k - mid) * 12 %>deg; --x:<%= (k - mid) * 38 %>px; z-index:<%= k + 1 %>">
                  <img src="<%= cld(src, 'w_260,h_320,c_fill,q_auto,f_auto') %>" alt="" loading="lazy">
                </div>
              <% }) %>
            </div>
          <% } %>

          <h3><%= pkg.packageName %></h3>
          <div class="amt"><%= inr(pkg.price) %> <small>onwards</small></div>
          <ul>
            <% (pkg.bulletFeatures || []).forEach((item) => { %>
              <li><%= item %></li>
            <% }) %>
          </ul>
          <a href="/packages/<%= pkg._id %>" class="btn <%= i === 1 ? 'btn-gold' : 'btn-red' %>">Book This Package</a>
        </div>
      <% }) %>
    </div>
    <% if (packAll.length > PACK_LIMIT) { %>
      <div class="center"><a href="/packages" class="btn btn-line">Load More Packages</a></div>
    <% } %>
  </div>
</section>
<div class="garland"></div>

<!-- WHATSAPP -->
<section id="contact">
  <div class="wrap">
    <div class="wa">
      <span class="emoji">🙏</span>
      <h2>Need help choosing the right artist?</h2>
      <p>Share your event date on WhatsApp and our team will suggest the best options within minutes.</p>
      <a class="btn btn-wa" href="https://wa.me/919999999999?text=Hello%20BhajanKirtan%2C%20I%20want%20to%20book%20an%20artist" target="_blank" rel="noopener">Chat on WhatsApp</a>
    </div>
  </div>
</section>

<!-- ABOUT -->
<section id="about" style="padding-top:0">
  <div class="wrap about-grid about">
    <div class="about-arch">🪔</div>
    <div>
      <h2>About BhajanKirtan</h2>
      <div class="orn" style="justify-content:flex-start"><span style="width:70px;height:2px;background:var(--gold)"></span></div>
      <p>BhajanKirtan connects families with experienced devotional artists for every sacred occasion. From intimate satsangs to grand all-night jagratas, we take care of the artists, the schedule and the details, so you can be fully present in the celebration.</p>
      <p>Every performer is personally verified, and every booking is confirmed by our team before your event.</p>
      <div class="stats">
        <div class="stat"><b>500+</b><span>Events done</span></div>
        <div class="stat"><b>40+</b><span>Artists</span></div>
        <div class="stat"><b>4.9★</b><span>Avg. rating</span></div>
      </div>
    </div>
  </div>
</section>

<%- include("../partials/footer") %>